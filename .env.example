# 32 baytli base64 kalit. Uni faqat server muhitida saqlang.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CONFIG_ENCRYPTION_KEY=

# Production public address. Deploy platformasida ham shu qiymatni bering.
NEXT_PUBLIC_APP_URL=https://auto.aipixel.uz

# Telegram worker bu tokenni admin paneldan shifrlangan volume ichida o‘qiydi.
# Bot token saqlangandan keyin polling avtomatik boshlanadi.
BOT_MODE=polling
DOCTOR_TELEGRAM_ID=

# "mock" rejim siyosat testlari uchun; "polling" Telegram Bot API bilan ishlaydi.
BOT_MODE=mock
TELEGRAM_BOT_TOKEN=

# Shifokor avval botga /start yozgan bo‘lishi kerak.
DOCTOR_TELEGRAM_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=

# Vergul bilan ajrating. Admin va allowlist foydalanuvchilari avtomatik cheklanmaydi.
ALLOWED_DOMAINS=
ALLOWLIST_USER_IDS=

# Faqat klinika/shifokor tasdiqlagan matnni kiriting. Bo‘sh qoldirilsa bot guruhga
# shoshilinch xabar yubormaydi, faqat shifokorga signal beradi.
URGENT_GROUP_TEMPLATE=
